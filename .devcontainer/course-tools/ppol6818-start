#!/bin/bash
# Runs each time VS Code connects to a PPOL 6818 codespace (the feature's
# postAttachCommand), as the student. Installs the course's own VS Code
# extensions, kept in the image, into the VS Code server once it exists:
# the course extension (the layout at startup and the PPOL 6818 panel) and
# the course build of the PDF viewer. VS Code adds an extension installed
# this way to the open window.
code=$(ls -t ~/.vscode-remote/bin/*/bin/code-server 2>/dev/null | head -1)
[ -n "$code" ] || exit 0
have=$("$code" --extensions-dir ~/.vscode-remote/extensions --list-extensions --show-versions 2>/dev/null)
for vsix in /usr/local/share/ppol6818/*.vsix; do
  id=$(basename "$vsix" .vsix)   # publisher.name-version
  grep -qx "$(echo "$id" | sed -E 's/-([0-9.]+)$/@\1/')" <<<"$have" && continue
  "$code" --extensions-dir ~/.vscode-remote/extensions --install-extension "$vsix" --force >/dev/null 2>&1 \
    || echo "Could not install $(basename "$vsix")" >&2
done
exit 0
