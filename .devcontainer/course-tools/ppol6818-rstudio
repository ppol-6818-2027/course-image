#!/bin/bash
# Start RStudio Server in a PPOL 6818 codespace, on the course repository's
# project. Each course repository's devcontainer.json runs it as its
# postAttachCommand, from the repository folder; it is safe to rerun.
ws="${1:-$PWD}"

# RStudio starts R with a clean environment, so R would not see the
# codespace's GitHub sign-in, its name, or the student's Codespaces secrets.
# Hand them over in ~/.Renviron (course repositories have no .Renviron of
# their own, so R reads this one), readable only by the student.
umask 077
tmp=$(mktemp ~/.Renviron.XXXXXX)
for v in CODESPACES CODESPACE_NAME GITHUB_USER GITHUB_REPOSITORY GITHUB_TOKEN \
         GITHUB_SERVER_URL GITHUB_API_URL GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN \
         IPUMS_API_KEY KOBO_API_TOKEN KOBO_SERVER PATH; do
  [ -n "${!v:-}" ] && printf '%s="%s"\n' "$v" "${!v}" >> "$tmp"
done
mv "$tmp" ~/.Renviron

# Open the repository's project when RStudio starts.
proj=$(ls "$ws"/*.Rproj 2>/dev/null | head -1)
if [ -n "$proj" ]; then
  mkdir -p ~/.local/share/rstudio/projects_settings
  echo "$proj" > ~/.local/share/rstudio/projects_settings/next-session-project
fi

# Start RStudio unless it is already running. It runs as a child of this
# script; the codespace forwards port 8787 to a browser tab.
if ! pgrep -u "$(id -u)" -x rserver >/dev/null; then
  # First bring the course package up to date from GitHub, and only it: its
  # dependencies stay at the image's dated CRAN snapshot (install.sh), so a
  # fix to the package reaches a codespace made weeks ago, in about ten
  # seconds, without a new image. If GitHub cannot be reached, the copy in
  # the image is used.
  echo "Updating the ppol6818 package..."
  timeout 120 Rscript -e 'pak::pkg_install("bbdaniels/ppol6818", dependencies = FALSE, ask = FALSE)' \
    >/tmp/ppol6818-update.log 2>&1 || echo "Could not update ppol6818 (see /tmp/ppol6818-update.log); using the image's copy."
  USER=$(id -un) rserver &
  sleep 3
fi

# Keep the codespace awake while the student is working in R. GitHub stops
# an idle codespace (30 minutes by default) and counts only typing and
# terminal output as activity, not RStudio's browser traffic, so a student
# working only in RStudio would be stopped mid-work. This terminal prints a
# line every 4 minutes while the student has worked in the last 30 minutes:
# saved a file in the repository, typed in an open document (RStudio keeps
# unsaved text under .Rproj.user/*/sources) or run a console command (its
# history database). RStudio's own bookkeeping, which goes on while a tab
# sits open and untouched (lock files, the console buffer, session state),
# does not count, so a forgotten tab lets the codespace stop on its own
# timeout instead of using up the student's hours. RStudio also suspends an
# R session left idle for 30 minutes (rsession.conf, set by the course
# image). One heartbeat per codespace.
# The student's repositories are the folders beside this one: the lab
# repository the codespace was created on and the pair's project repository
# the course package clones next to it (/workspaces/.codespaces, GitHub's own,
# is left out).
window="-30 minutes"
working() {
  local f repos
  repos=$(find "$(dirname "$ws")" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null)
  [ -z "$repos" ] && repos="$ws"
  f=$(find $repos \( -name .git -o -name .Rproj.user \) -prune \
        -o -newermt "$window" -type f -print -quit 2>/dev/null)
  [ -z "$f" ] && f=$(find $(printf '%s/.Rproj.user/*/sources ' $repos) ~/.local/share/rstudio/sources \
        -newermt "$window" -type f ! -name 'lock_file' ! -name '.rstudio-lock*' \
        -print -quit 2>/dev/null)
  [ -z "$f" ] && f=$(find ~/.local/share/rstudio/history_database \
        -newermt "$window" -print -quit 2>/dev/null)
  [ -n "$f" ]
}
exec 9>/tmp/ppol6818-heartbeat.lock
if flock -n 9; then
  while pgrep -u "$(id -u)" -x rserver >/dev/null; do
    if working; then
      printf '\r%s  You are working in RStudio; keeping this codespace awake.' "$(date +%H:%M)"
    fi
    sleep 240
  done
else
  wait
fi
